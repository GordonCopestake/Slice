{
  "name": "slice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "check": "npm run typecheck && npm test",
    "start": "node dist/apps/server/src/main.js",
    "smoke:local": "npm run build && node dist/apps/server/src/diagnostics/model-smoke.js local",
    "smoke:openai": "npm run build && node dist/apps/server/src/diagnostics/model-smoke.js openai"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  }
}
