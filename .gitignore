# Dependencies and generated build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Test and browser-run output
test-results/
playwright-report/
.playwright/

# Local configuration and credentials
.env
.env.*
!.env.example
!.env.test.example
# The natural copy target of config/examples/local.env.example, which would hold a real key.
config/examples/*.env
config/examples/local.env
.ssh/
id_rsa
id_ed25519

# Local Slice state, artifacts, and worktrees
/.slice/
/.artifacts/
# Backstop: a state database must never be committed, whatever directory it lands in.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.tmp/
tmp/

# OS metadata
.DS_Store
Thumbs.db
