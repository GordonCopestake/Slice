# Copy the needed values into the service manager's protected environment.
# Do not put a real key in this file.
SLICE_STATE_DIR=./.slice
SLICE_PORT=3000

# Optional local OpenAI-compatible model profile.
# The context window defaults to 256k and the reply budget to 32k; set them per model.
SLICE_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
SLICE_LOCAL_MODEL_ID=replace-with-local-model-id
SLICE_LOCAL_CONTEXT_TOKENS=262144
SLICE_LOCAL_OUTPUT_TOKENS=32768
# Only when the local endpoint checks an API key. A keyless endpoint is sent a non-secret placeholder.
SLICE_LOCAL_API_KEY=replace-with-local-endpoint-key

# Optional OpenAI profile; set OPENAI_API_KEY outside this file.
SLICE_OPENAI_MODEL_ID=replace-with-approved-openai-model-id
