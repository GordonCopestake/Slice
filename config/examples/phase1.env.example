# Phase 1 service environment example. Copy the needed values into the service manager's
# protected environment. Do not put a real password, token, or identity path in this file.

SLICE_STATE_DIR=/var/lib/slice
SLICE_PORT=3000

# Single-owner sign-in. Read from the environment only; stored as a scrypt derivation.
# Set SLICE_COOKIE_SECURE=1 when the service sits behind the TLS reverse proxy.
SLICE_OWNER_PASSWORD=replace-with-a-long-owner-password
SLICE_COOKIE_SECURE=0

# Requirements role model profile (a provider configured by one of the model profiles above,
# e.g. slice-local or openai-codex after npm run auth:openai).
SLICE_REQUIREMENTS_PROVIDER=replace-with-provider-id
SLICE_REQUIREMENTS_MODEL_ID=replace-with-model-id

# Runner. "local" runs the bundled runner on this host (single-machine demo);
# "ssh" invokes it on a registered host with a pinned key in <state>/known_hosts/<hostId>.
SLICE_RUNNER_MODE=local
SLICE_RUNNER_ROOT=/srv/slice/jobs
# Absolute path of dist/runner/main.js on the runner host (ssh mode).
SLICE_RUNNER_ENTRY=/usr/local/slice/runner/main.js
# Web app assets directory (defaults to apps/web/public relative to the service working directory).
SLICE_WEB_DIR=/opt/slice/dist/apps/web/public
# Optional SSH identity and GitHub token; environment only, never committed.
# SLICE_SSH_IDENTITY_FILE=/etc/slice/id_ed25519
# SLICE_GITHUB_TOKEN=replace-outside-this-file

# Phase 3: Telegram alerts and periodic report delivery (optional). Read from the
# environment only; the token never appears in argv, logs, stored rows, or model context.
# SLICE_TELEGRAM_BOT_TOKEN=replace-outside-this-file
