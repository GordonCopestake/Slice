# Phase 2 delivery environment. Copy into the service manager's protected environment.
# Never put a real token in this file; it is an example of the variable names only.

# GitHub identity used to read issues and to create/promote pull requests and publish gate
# checks. The service code has no merge capability; host-side protection (branch rules, an
# App without Contents:write, a separate check App) is verified by the live onboarding check.
SLICE_GITHUB_TOKEN=replace-outside-this-file

# Branch-writer credential for https remotes. It reaches git only through an askpass helper
# reading this variable; it is never placed in argv, a URL, the runner, or a model context.
SLICE_GIT_PUSH_TOKEN=replace-outside-this-file

# The three delivery roles. All three must be set, and the three provider/model pairs must be
# distinct: the same model under another prompt does not satisfy independent review.
SLICE_AUTHOR_PROVIDER=replace-with-provider-id
SLICE_AUTHOR_MODEL_ID=replace-with-model-id
SLICE_CODE_REVIEW_PROVIDER=replace-with-provider-id
SLICE_CODE_REVIEW_MODEL_ID=replace-with-different-model-id
SLICE_SECURITY_REVIEW_PROVIDER=replace-with-provider-id
SLICE_SECURITY_REVIEW_MODEL_ID=replace-with-another-model-id

# Per-project push remote (registered through POST /api/projects, optional).
# Defaults to https://github.com/<repoSlug>.git. A single-machine trial may use
# "file:///srv/slice/demo/origin.git" to exercise push and cleanup without GitHub.
