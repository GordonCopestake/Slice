# Phase 4 host, model-policy, and release environment. Copy into the service manager's protected
# environment. Never put a real token in this file; it is an example of the variable names only.

# Serving. The defaults are loopback-only. Reaching the owner UI from another machine means naming
# both the interface to bind and every Host value allowed to reach it; a wildcard bind or a wildcard
# allowlist is not supported, and an unnamed Host is refused with 421.
#   SLICE_PORT=3000                        - default
#   SLICE_BIND_ADDRESS=127.0.0.1           - default; an IP literal, IPv4 or IPv6
#   SLICE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]   - default
# Example for a tailnet-only listener:
#   SLICE_BIND_ADDRESS=100.105.67.23
#   SLICE_ALLOWED_HOSTS=100.105.67.23
# The session cookie is HttpOnly and SameSite=Strict. Set SLICE_COOKIE_SECURE=1 behind TLS; over a
# plain-HTTP tailnet listener the password crosses the wire unencrypted by this service, so bind to
# the tailnet interface only rather than every interface.
SLICE_PORT=3000
SLICE_BIND_ADDRESS=127.0.0.1
SLICE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# SLICE_COOKIE_SECURE=1

# Providers the owner considers local. "Local" is never inferred from a provider's name: a project
# with allowCloud false can only use a provider listed here, and with nothing listed here such a
# project is blocked with a stated reason rather than quietly run on a cloud model.
SLICE_LOCAL_PROVIDERS=ollama,llama.cpp

# Hosts and pools are registered through the API, not the environment:
#   POST /api/hosts        { hostId, address, os: "linux"|"windows", sshUser, runnerRoot, capacity, enabled }
#   POST /api/host-pools   { poolId, hosts: [hostId, ...] }
# A Windows host uses a drive root (D:\slice\jobs); a Linux host uses a POSIX absolute path.
# Shell metacharacters are refused in either form.

# Per-project rules are registered through POST /api/projects:
#   requiredOs   "linux" | "windows"  - placement refuses a worker of the other OS
#   poolId                            - draw from a pool instead of a single host
#   toolchain    [{ id, command }]    - plain argv probes; a Windows project must declare them
#   modelRules   { allowedProviders, allowedModelIds, allowCloud, localOnlyRoles }
# A project with a toolchain cannot be activated until a usable host passes
# POST /api/projects/<id>/toolchain-check, and its jobs block with toolchain_unverified before any
# workspace is prepared.

# Release rehearsal needs the runner and the retained bundle artifact only. It uses no production
# credential and Slice still has no merge capability:
#   GET  /api/projects/<id>/releases
#   POST /api/projects/<id>/releases/<releaseId>/restore-staging
#   GET  /api/projects/<id>/rollback-rehearsals
